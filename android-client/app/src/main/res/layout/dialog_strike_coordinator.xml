<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_transparent_glass"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStrikeIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_accent_button"
            android:gravity="center"
            android:text="🚀"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStrikeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="STRATEGIC STRIKE COORDINATOR"
                android:textColor="@color/white"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvStrikeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Designated Coordinates"
                android:textColor="@color/accent_orange"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseStrikeSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <!-- STATUS INFO BANNER -->
    <TextView
        android:id="@+id/tvStrikeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#22FF9500"
        android:fontFamily="sans-serif-bold"
        android:padding="6dp"
        android:text="VIABLE MISSILES IN RANGE"
        android:textColor="@color/accent_orange"
        android:textSize="10sp" />

    <!-- SCROLLABLE LIST OF VIABLE MISSILES -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/containerStrikeMissiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- BOTTOM DISMISS BUTTON -->
    <Button
        android:id="@+id/btnBottomCancelStrike"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_secondary_button"
        android:fontFamily="sans-serif-bold"
        android:text="✕ CANCEL STRIKE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>
