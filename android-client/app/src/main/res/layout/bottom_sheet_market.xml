<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#3A4D6B" />

    <!-- TOP HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_market" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="GLOBAL TACTICAL EXCHANGE"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTHORITATIVE COMMODITIES &amp; EQUITIES"
                android:textColor="@color/accent_cyan"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseMarket"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <!-- LIVE NEWS TICKER BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_stat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_progress"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="⚡ FLASH"
            android:textColor="@color/accent_orange"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/tvMarketNewsTicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Aegis Defence Corp awarded multi-sector theater SAM contract; demand surging."
            android:textColor="@color/white"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- PORTFOLIO SUMMARY CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_hud"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORTFOLIO VALUE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPortfolioValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="$0.00"
                    android:textColor="@color/accent_cyan"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL P&amp;L"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvPortfolioPnL"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="+$0.00 (+0.0%)"
                    android:textColor="@color/accent_green"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#263852" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvailableCash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cash: $10,000"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalInvested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invested: $0.00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- CATEGORY FILTER TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMarketTabAll"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-black"
            android:text="ALL"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnMarketTabCommodities"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="sans-serif-black"
            android:text="COMMODITIES"
            android:textColor="@color/white"
            android:textSize="9.5sp" />

        <Button
            android:id="@+id/btnMarketTabEquities"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="sans-serif-black"
            android:text="EQUITIES"
            android:textColor="@color/white"
            android:textSize="9.5sp" />

        <Button
            android:id="@+id/btnMarketTabHoldings"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.1"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="sans-serif-black"
            android:text="PORTFOLIO"
            android:textColor="@color/white"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- ASSET LIST SCROLL CONTAINER -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAssetList"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/containerMarketAssets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- EMBEDDED BUY/SELL SHEET (VISIBLE UPON TRADE CLICK) -->
    <LinearLayout
        android:id="@+id/layoutTradeSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_hud"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- TRADE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTradeAssetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="TRADE: TITANIUM ORE (ORE)"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTradeAssetHoldingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owned: 0 • Market Price: $48.00"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseTradeSheet"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- BUY / SELL TOGGLE BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTradeModeBuy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_accent_button"
                android:fontFamily="sans-serif-black"
                android:text="BUY"
                android:textColor="@color/bg_tactical_dark"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTradeModeSell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="sans-serif-black"
                android:text="SELL"
                android:textColor="@color/accent_orange"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- QUANTITY PRESETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQty1"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnQty5"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnQty10"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnQty50"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="50"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnQtyMax"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_secondary_button"
                android:fontFamily="sans-serif-black"
                android:text="MAX"
                android:textColor="@color/accent_orange"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- QUANTITY STEPPER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQtyMinus"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_secondary_button"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTradeQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnQtyPlus"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_secondary_button"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- TRADE COST SUMMARY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTradeTotalCost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Total Cost: $480.00"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTradeRemainingCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance After: $9,520"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- EXECUTE BUTTON -->
        <Button
            android:id="@+id/btnExecuteTrade"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-black"
            android:text="CONFIRM BUY"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
