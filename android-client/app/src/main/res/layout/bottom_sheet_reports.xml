<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#4DFFFFFF" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_reports" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="TACTICAL INTEL &amp; REPORTS"
            android:textColor="@color/white"
            android:letterSpacing="0.04"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvReportCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_stat"
            android:fontFamily="sans-serif-black"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="● 12 Events"
            android:textColor="@color/accent_orange"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabCombatLogs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-black"
            android:text="COMBAT &amp; INTEL"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="11.5sp" />

        <Button
            android:id="@+id/btnTabLeaderboards"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:fontFamily="sans-serif-bold"
            android:text="LEADERBOARDS"
            android:textColor="@color/white"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Filter Buttons Bar (Combat Logs) -->
    <LinearLayout
        android:id="@+id/layoutFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-bold"
            android:text="ALL"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnFilterCombat"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_secondary_button"
            android:text="COMBAT"
            android:textColor="@color/white"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnFilterEconomy"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_secondary_button"
            android:text="ECONOMY"
            android:textColor="@color/white"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnFilterRadar"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_secondary_button"
            android:text="RADAR"
            android:textColor="@color/white"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Leaderboard Metric Filter (Visible in Leaderboards tab) -->
    <LinearLayout
        android:id="@+id/layoutLeaderboardMetricBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMetricWealth"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_accent_button"
            android:fontFamily="sans-serif-bold"
            android:text="WEALTH ($)"
            android:textColor="@color/bg_tactical_dark"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnMetricTerritory"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_secondary_button"
            android:text="TERRITORY (km²)"
            android:textColor="@color/white"
            android:textSize="10.5sp" />

        <Button
            android:id="@+id/btnMetricXp"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_secondary_button"
            android:text="COMBAT XP"
            android:textColor="@color/white"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Dynamic Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp">

        <LinearLayout
            android:id="@+id/reportsContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
